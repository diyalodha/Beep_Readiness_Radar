# Beep Readiness Radar - Environment Configuration Example
# Copy this file to .env and configure your secrets locally.
# Never commit your actual .env file to version control.

# Server Port (default: 5000)
PORT=5000

# Google Gemini API Key (Required for live LLM semantic analysis and adaptive quiz generation)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If left blank, the server transparently operates in Fallback Analysis (Dynamic Heuristic Engine) mode.
GEMINI_API_KEY=

# Gemini Model Identifier (default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# JSON Web Token Secret (Required for student authentication and session signing)
# Must be at least 32 characters in production.
JWT_SECRET=your-random-jwt-secret-key-min-32-chars-change-in-production

# Node Environment ('development' | 'production')
NODE_ENV=development
